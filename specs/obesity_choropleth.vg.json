{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Adult Obesity Rates by Country (2023)",
    "subtitle": [
      "Rate = % of adults with BMI ≥ 30",
      "Data: Obesity_Country_Rates.csv + Natural Earth Admin-0 (110m)"
    ]
  },
  "width": 960,
  "height": 520,
  "projection": { "type": "equalEarth" },
  "layer": [
    {
      "data": { "sphere": true },
      "mark": { "type": "geoshape", "fill": "#eaf4ff" }
    },
    {
      "data": { "graticule": { "step": [30, 30] } },
      "mark": {
        "type": "geoshape",
        "stroke": "#cfd8dc",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": { "type": "topojson", "feature": "ne_110m_admin_0_countries" }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/Obesity_Country_Rates.csv" },
            "key": "country",
            "fields": ["obesityRatesByCountry_obesityRate"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 0.5 },
      "encoding": {
        "color": {
          "field": "obesityRatesByCountry_obesityRate",
          "type": "quantitative",
          "title": "Obesity rate (%)",
          "scale": { "scheme": "blues", "domain": [0, 60] },
          "legend": {
            "orient": "right",
            "tickCount": 6,
            "grid": true
          }
        },
        "tooltip": [
          { "field": "properties.NAME", "type": "nominal", "title": "Country" },
          {
            "field": "obesityRatesByCountry_obesityRate",
            "type": "quantitative",
            "title": "Obesity rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "grid": true,
      "gridColor": "#e0e0e0",
      "gridWidth": 0.6
    },
    "background": "white",
    "view": { "stroke": "transparent" }
  }
}
